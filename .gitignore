# Generic rules FIRST: per-app root-anchored entries meant every NEW app was
# unignored by default - app-ocr's node_modules and dist were staged this way.
node_modules/
dist/
target/

# Rust build output
/target/

# Node / Vite
/app/node_modules/
/app/dist/
/app-img/node_modules/
/app-img/dist/
/app-zip/node_modules/
/app-zip/dist/
/app-img2pdf/node_modules/
/app-img2pdf/dist/
/app-scrub/node_modules/
/app-scrub/dist/

# Landing page build output (assembled by scripts/build-site.mjs)
/site/dist/

# Generated by wasm-pack (rebuilt by `make build` and CI)
/app/src/wasm/
/app-img/src/wasm/
/app-zip/src/wasm/
/app-img2pdf/src/wasm/
/app-scrub/src/wasm/

# Misc
*.log
.DS_Store

# Staging test corpus (regenerated by scripts/build-corpus.sh; third-party/personal PDFs not committed)
/test-corpus/

# wrangler local state
.wrangler/

# image smoke corpus (generated, not committed to public repo)
img-corpus/
shots-img/

# archive smoke corpus (generated, not committed to public repo)
zip-corpus/
shots-zip/
# scrubber smoke corpus + venv (generated, not committed to public repo)
scrub-corpus/
shots-scrub/
.scrubvenv/

# images->PDF smoke corpus (generated)
img2pdf-corpus/
shots-img2pdf/

# notice gate corpus + screenshots (regenerated by scripts/notice-fixtures.mjs)
notice-corpus/
notice-shots/

# Rust build output for the OCR crate (the root /target/ rule does not cover it)
/core-ocr/target/
# app-ocr is an unshipped spike: built output and generated wasm stay out of git
/app-ocr/dist/
/app-ocr/src/wasm/
