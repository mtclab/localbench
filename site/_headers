# keeplocal.tools — the landing page is static, first-party only.
# script-src no longer needs 'unsafe-inline': the theme + receipt logic moved to
# /site.js, so the page loads zero inline script and zero external anything.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
